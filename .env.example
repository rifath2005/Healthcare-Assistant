# ==============================================================================
# Smart Healthcare Assistant - Environment Configuration
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini API (Generative AI & text-embedding-004)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyDummyKey_ReplaceWithActualGeminiKey

# Supabase Credentials (PostgreSQL, pgvector, Auth & Storage)
# Get from: https://supabase.com/dashboard/project/<project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key

# Google Calendar & Service Account (2-legged clinic scheduling delegation)
# Download JSON key from Google Cloud Console Service Account
GOOGLE_CALENDAR_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=GOCSPX-your-calendar-client-secret
GOOGLE_SERVICE_ACCOUNT_EMAIL=healthcare-clinic-service@your-project.iam.gserviceaccount.com
# Provide the raw RSA private key with standard newlines or escaped \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Resend Transactional Email API (Appointment confirmations & reminders)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_123456789_dummy_resend_api_key
EMAIL_FROM=appointments@healthcare-assistant.local

# Vercel Cron Security Secret (for /api/cron/reminders)
CRON_SECRET=super-secret-cron-token-32chars

# AES-256-GCM Encryption Key (Field-level encryption for clinical notes)
# Must be a 32-byte hex or base64 string
CLINICAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cloudflare Turnstile Bot Defense (Optional / Free Tier)
# Site key for client widget, secret key for server verification
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Upstash Redis (Optional for persistent distributed rate-limiting)
# Falls back to in-memory sliding window when omitted
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry Full-Stack Error Monitoring (Optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
